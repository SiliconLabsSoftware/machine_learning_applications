<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="6dp" />
            <solid android:color="@color/aura_progress_track" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="6dp" />
                <gradient
                    android:angle="0"
                    android:endColor="@color/aura_red"
                    android:centerColor="@color/aura_orange"
                    android:startColor="#F9C36B" />
            </shape>
        </clip>
    </item>
</layer-list>
